# Copie para .env.local (local) e cole as mesmas variáveis na Vercel.

# Supabase → botão "Connect" → aba "Transaction pooler" (porta 6543).
# Use SEMPRE o pooler em modo transação em serverless; a conexão direta
# (porta 5432) esgota o limite de conexões do Postgres na Vercel.
# Troque [YOUR-PASSWORD] pela senha do banco definida na criação do projeto.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Schema do Postgres onde o Prospecta cria as tabelas.
# Deixe em branco (ou "public") se o banco for exclusivo do Prospecta.
# Se estiver dividindo o banco com outro projeto, use um schema próprio —
# assim nada colide com as tabelas que já existem lá.
DB_SCHEMA="prospecta"

# Chave que assina os cookies de sessão. Gere uma string aleatória longa
# (mínimo 16 caracteres). Trocar essa chave desloga todo mundo.
AUTH_SECRET="troque-por-uma-string-aleatoria-bem-longa"

# Senha do endpoint POST /api/seed (carga da base de demonstração).
# Sem isso, o seed é bloqueado em produção. Invente uma string longa.
SEED_TOKEN="troque-por-uma-string-aleatoria-longa"

# Opcional: conector de CNPJ para enriquecer empresas com QSA real.
# Ex.: https://brasilapi.com.br/api/cnpj/v1
# PROSPECTA_CNPJ_API=""

# Login com Google (opcional). Google Cloud Console -> APIs e servicos ->
# Credenciais -> ID do cliente OAuth -> Aplicativo da Web.
# URI de redirecionamento autorizado:
#   https://SEU-APP.vercel.app/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback  (para testar local)
# Sem estas duas variaveis, o botao do Google simplesmente nao aparece.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
