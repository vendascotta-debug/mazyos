# Conexao do Postgres (Neon). Mesmo projeto do Prospecta, schema separado.
# Neon: Connect -> Show password -> Copy snippet
DATABASE_URL=

# Schema onde o LINKFIVE cria as tabelas. Mantenha 'linkfive' para nao colidir
# com as tabelas do Prospecta, que vivem em 'prospecta'.
DB_SCHEMA=linkfive

# Segredo que assina o cookie de sessao. Minimo 16 caracteres.
# Gere um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# URL publica do site, usada no QR Code e nos links compartilhaveis.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails que viram administradores automaticamente (separados por virgula).
# E daqui que nasce o primeiro admin: sem isso ninguem conseguiria abrir o
# painel pela primeira vez, porque so um admin pode promover outro.
ADMIN_EMAILS=

# --- Cobranca (Lastlink) --------------------------------------------------
# Token compartilhado que autentica o webhook. Sem ele a rota responde 503,
# porque aberta qualquer um poderia liberar plano pago mandando um POST.
# Gere um token com o mesmo comando do AUTH_SECRET, acima.
LASTLINK_WEBHOOK_SECRET=

# De qual plano e cada produto do Lastlink: idDoProduto:plano, separados por virgula.
# Os ids saem do painel do Lastlink e mudam sem aviso — por isso ficam aqui e
# nao no codigo.
LASTLINK_PRODUTOS=

# Link do checkout de cada plano pago.
LASTLINK_CHECKOUT_STARTER=
LASTLINK_CHECKOUT_PRO=
LASTLINK_CHECKOUT_BUSINESS=

# --- Envio de e-mail (recuperacao de senha) --------------------------------
# Sem nenhuma das opcoes abaixo, o e-mail e impresso no terminal em vez de
# enviado. Serve para desenvolvimento; em producao ele NAO chega ao cliente.
#
# O remetente precisa ser um endereco do proprio dominio, com o dominio
# verificado no servico. E-mail automatico saindo de @gmail.com para o cliente
# e barrado ou vai para spam: o Gmail nao autoriza outro servico a assinar em
# nome dele.
EMAIL_REMETENTE="LINKFIVE <nao-responda@linkfive.com.br>"

# Para onde vai a resposta, se o cliente responder o e-mail automatico. O
# nao-responda@ nao precisa existir como caixa (o dominio verificado so serve
# para ENVIAR), mas gente responde e-mail automatico o tempo todo -- sem isso a
# resposta some.
EMAIL_RESPOSTA=linkfive.app@gmail.com

# OPCAO 1 (recomendada) — Resend. Conta gratis, 3.000 e-mails/mes.
# Verificar o linkfive.com.br no painel deles e colar os registros no DNS da
# Hostinger. A chave comeca com re_.
#
# O dominio verificado NAO e opcional aqui. Sem ele o Resend so deixa enviar
# para o e-mail dono da conta -- serve para um app que manda aviso para voce
# mesmo, mas nao para a recuperacao de senha, onde o destinatario e o cliente.
#
# Depois de preencher: npm run email:testar seu@email.com
RESEND_API_KEY=

# OPCAO 2 — qualquer servidor SMTP, inclusive o e-mail do proprio dominio na
# Hostinger. So e usada quando RESEND_API_KEY esta vazia.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Entrar com o Google ---------------------------------------------------
# Sem estas duas, o botao "Continuar com o Google" simplesmente nao aparece --
# de proposito: botao de login que leva a erro e pior que botao nenhum.
#
# Google Cloud -> APIs e Servicos -> Credenciais -> ID do cliente OAuth ->
# Aplicativo da Web. Cadastre os DOIS enderecos de retorno:
#   https://linkfive.com.br/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
#
# O ID do cliente nao e segredo (ele aparece na propria URL do Google), por
# isso e NEXT_PUBLIC_: a tela de login usa a mesma variavel para decidir se
# mostra o botao. A chave secreta nunca sai do servidor.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
